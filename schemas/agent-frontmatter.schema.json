{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ubehera/claude-agents-pro/schemas/agent-frontmatter.schema.json",
  "title": "Claude Code Agent Frontmatter Schema",
  "description": "Comprehensive validation schema for Claude Code agent YAML frontmatter metadata",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Agent identifier, must match filename (kebab-case)",
      "minLength": 3,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 500,
      "description": "Clear, concise agent purpose and capabilities summary (50-500 characters)."
    },
    "category": {
      "type": "string",
      "enum": [
        "orchestrator",
        "foundation",
        "development",
        "specialist",
        "expert",
        "integration",
        "quality",
        "finance",
        "research",
        "security"
      ],
      "description": "Agent tier category for orchestration and routing."
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "moderate", "complex", "expert"],
      "description": "Task complexity level the agent handles. Guides model selection and delegation strategy."
    },
    "classification": {
      "type": "string",
      "enum": [
        "🔴 CRITICAL",
        "🟠 COMPLEX",
        "🟡 STANDARD",
        "🟢 OPERATIONAL",
        "🔵 SPECIALIZED"
      ],
      "description": "Visual classification for agent criticality and operational impact."
    },
    "model": {
      "type": "string",
      "pattern": "^(claude-|gpt-|sonnet|opus|haiku)",
      "description": "Recommended model ID for agent execution (e.g., claude-sonnet-4-5, claude-opus-4-5).",
      "examples": ["claude-sonnet-4-5", "claude-opus-4-5", "claude-haiku-4"]
    },
    "model_rationale": {
      "type": "string",
      "minLength": 30,
      "description": "Justification for model selection based on task complexity, token budget, and performance requirements."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "minItems": 3,
      "maxItems": 15,
      "uniqueItems": true,
      "description": "List of key agent capabilities"
    },
    "auto_activate": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "minItems": 3,
          "maxItems": 20,
          "uniqueItems": true,
          "description": "Keywords that trigger automatic agent activation"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100
          },
          "minItems": 1,
          "maxItems": 10,
          "description": "Conditions under which agent should be activated"
        }
      },
      "required": ["keywords"],
      "additionalProperties": false
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200,
            "description": "Natural language that would invoke this agent"
          },
          "commentary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300,
            "description": "Explanation of why this triggers the agent and expected outcome"
          }
        },
        "required": ["trigger", "commentary"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 5,
      "description": "Usage examples with commentary"
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Read",
          "Write",
          "Edit",
          "MultiEdit",
          "NotebookEdit",
          "Bash",
          "Grep",
          "Glob",
          "TodoWrite",
          "Task",
          "WebSearch",
          "WebFetch",
          "mcp__memory__search_nodes",
          "mcp__memory__create_entities",
          "mcp__memory__create_relations",
          "mcp__memory__add_observations",
          "mcp__memory__open_nodes",
          "mcp__memory__delete_entities",
          "mcp__sequential-thinking__create_thread",
          "mcp__fetch__fetch",
          "mcp__Ref__search",
          "mcp__shadcn__*",
          "mcp__ide__*",
          "mcp__codex__*",
          "mcp__playwright__*",
          "mcp__context7__*"
        ]
      },
      "description": "Minimal set of tools required for agent operation (least-privilege principle)."
    },
    "triggers": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      },
      "description": "Natural language phrases or keywords that route tasks to this agent.",
      "examples": [
        ["design API", "REST endpoint", "GraphQL schema", "OpenAPI spec"],
        ["review code", "code quality", "refactor", "architectural review"]
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "description": "Skills this agent can load on-demand"
    },
    "delegates_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true,
      "description": "Other agents this agent typically delegates to"
    },
    "capability_domains": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": ["basic", "intermediate", "advanced", "expert"]
              },
              "description": { "type": "string" },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        ]
      },
      "description": "Structured capability mapping for agent domain expertise (e.g., authentication: {level: 'expert', description: 'OAuth2, JWT, RBAC'})."
    },
    "delegation_patterns": {
      "type": "object",
      "properties": {
        "upstream": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agents that typically delegate to this agent."
        },
        "downstream": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agents this agent delegates to for specialized tasks."
        },
        "coordination": {
          "type": "string",
          "enum": ["sequential", "parallel", "review", "bidirectional"],
          "description": "Coordination pattern for multi-agent workflows."
        }
      },
      "description": "Agent orchestration and delegation relationships for complex workflows."
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "criteria"],
        "properties": {
          "name": { "type": "string" },
          "criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "enforcement": {
            "type": "string",
            "enum": ["required", "recommended", "optional"]
          }
        }
      },
      "description": "Quality validation checkpoints the agent enforces during workflow execution."
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1000,
          "description": "Maximum context window size for agent operation."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum retry/iteration attempts before escalation."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "description": "Maximum execution time before timeout."
        },
        "requires_human_approval": {
          "type": "boolean",
          "description": "Whether agent actions require explicit user confirmation."
        }
      },
      "description": "Operational constraints and guardrails for agent execution."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of agent implementation (e.g., 1.2.0)."
    },
    "last_updated": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date of last agent update (YYYY-MM-DD)."
    },
    "maintainer": {
      "type": "string",
      "description": "Primary maintainer or team responsible for agent updates."
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Searchable tags for agent discovery and filtering.",
      "examples": [["api", "rest", "graphql", "backend", "authentication"]]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complexity": { "const": "expert" }
        }
      },
      "then": {
        "required": ["model", "model_rationale"],
        "properties": {
          "model": {
            "pattern": "^claude-opus"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": { "const": "🔴 CRITICAL" }
        }
      },
      "then": {
        "required": ["quality_gates", "constraints"]
      }
    }
  ],
  "examples": [
    {
      "name": "api-platform-engineer",
      "description": "Designs and builds production-ready REST, GraphQL, and gRPC APIs with OpenAPI/AsyncAPI contracts, authentication strategies, and rate limiting.",
      "category": "foundation",
      "complexity": "complex",
      "classification": "🟠 COMPLEX",
      "model": "claude-sonnet-4-5",
      "model_rationale": "Sonnet 4.5 provides optimal balance for API design tasks requiring schema generation, authentication flow design, and integration pattern selection within ~20K token context.",
      "tools": [
        "Read",
        "Write",
        "Edit",
        "Bash",
        "Grep",
        "Glob",
        "TodoWrite",
        "Task",
        "mcp__memory__search_nodes",
        "mcp__memory__create_entities"
      ],
      "triggers": [
        "design API",
        "REST endpoint",
        "GraphQL schema",
        "OpenAPI spec",
        "API authentication"
      ],
      "capabilities": [
        "REST API design",
        "GraphQL schema design",
        "OpenAPI 3.1 specification",
        "API gateway configuration",
        "OAuth2/JWT authentication"
      ],
      "auto_activate": {
        "keywords": ["api", "rest", "graphql", "openapi", "swagger", "endpoint"],
        "conditions": ["User mentions API design", "OpenAPI spec needed"]
      },
      "examples": [
        {
          "trigger": "Design a REST API for user management with OAuth2 authentication",
          "commentary": "Agent analyzes requirements, designs OpenAPI 3.1 spec with security schemes, delegates to security-architect for OAuth2 flow validation, generates implementation scaffolding."
        },
        {
          "trigger": "Add pagination to the products endpoint",
          "commentary": "Agent updates OpenAPI spec with pagination parameters (limit, offset), modifies controller to support cursor-based pagination for performance."
        }
      ],
      "capability_domains": {
        "api_design": {
          "level": "expert",
          "description": "REST, GraphQL, gRPC design patterns and best practices"
        },
        "authentication": {
          "level": "advanced",
          "description": "OAuth2, JWT, API key strategies"
        },
        "api_documentation": {
          "level": "expert",
          "description": "OpenAPI 3.1, AsyncAPI 2.x, GraphQL SDL"
        }
      },
      "delegation_patterns": {
        "upstream": ["agent-coordinator", "backend-architect"],
        "downstream": ["security-architect", "database-architect"],
        "coordination": "sequential"
      },
      "quality_gates": [
        {
          "name": "API Contract Validation",
          "criteria": [
            "OpenAPI/GraphQL schema passes validation",
            "Authentication flows documented",
            "Error responses standardized"
          ],
          "enforcement": "required"
        }
      ],
      "constraints": {
        "max_context_tokens": 20000,
        "max_iterations": 3,
        "timeout_seconds": 300,
        "requires_human_approval": false
      },
      "version": "1.0.0",
      "last_updated": "2025-12-11",
      "maintainer": "agent-forge",
      "tags": ["api", "rest", "graphql", "backend", "authentication", "openapi"]
    }
  ]
}
